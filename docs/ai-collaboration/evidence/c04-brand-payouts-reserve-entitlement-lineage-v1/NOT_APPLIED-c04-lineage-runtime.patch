+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+describe("C04 protected-funding lineage proposal", () => {
+  const source = (path: string) =>
+    readFileSync(join(process.cwd(), path), "utf8");
+
+  it("makes canonical securement request-only for every Brand role", () => {
+    expect(
+      source(
+        "src/features/collaboration/services/collaboration-securement.service.ts",
+      ),
+    ).toContain('agreement.paymentRail === "PLATFORM_ESCROW"');
+  });
+
+  it("persists exact reserve, approval, execution, lock and ledger lineage", () => {
+    const confirmation = source(
+      "src/features/collaboration/services/collaboration-trusted-confirmation.service.ts",
+    );
+    for (const field of [
+      "reserveInstructionId",
+      "reserveInstructionHash",
+      "payoutsApprovalRef",
+      "reserveExecutionAttemptRef",
+      "escrowLockId",
+      "reserveLedgerTransactionId",
+    ])
+      expect(confirmation).toContain(field);
+  });
+
+  it("binds normal entitlement hashing and persistence to exact lineage", () => {
+    const authority = source(
+      "src/features/collaboration/utils/collaboration-financial-authority.persistence.ts",
+    );
+    expect(authority).toContain("fundingConfirmationId");
+    expect(authority).toContain("reserveInstructionId");
+    expect(authority).toContain("CANONICAL_PAYOUTS_V1");
+  });
+});
