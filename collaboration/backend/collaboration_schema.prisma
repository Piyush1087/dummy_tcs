// PURPOSE
// -------
// This is the canonical TARGET WORKING VIEW for Collaboration persistence.
// It is intentionally separate from the untouched production baseline and from
// migration instructions. It is not a standalone replacement for the complete
// production Prisma schema; referenced Campaign/User/Brand/Payout models may be
// declared elsewhere in the integrated schema.
//
// IMPORTANT OPEN PRODUCT-DATA GAP
// --------------------------------
// `publishingRequired` is persisted below as a locked execution fact per
// Deliverable Execution. The upstream authoring/derivation rule that determines
// that fact is NOT YET FROZEN. Do not infer it from industry and do not assume
// every Deliverable must be published.
//
// DEFERRED POLICY
// ---------------
// PAUSED remains a legitimate lifecycle value, but pause/resume authority,
// timer effects and deadline-shift behavior are intentionally not encoded here.
// ============================================================================

// ============================================================================
// ENUMS
// ============================================================================

enum CollaborationLifecycle {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  TERMINATED
}

enum CollaborationStage {
  NEGOTIATION
  SECUREMENT
  FULFILLMENT
  PRODUCTION
  PUBLISHING_SETTLEMENT
}

enum CollaborationStageStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  SKIPPED
}

enum CollaborationActorClass {
  BRAND
  CREATOR
  SYSTEM
  ADMIN
}

enum CollaborationActionRequiredBy {
  BRAND
  CREATOR
  SYSTEM
  ADMIN
  NONE
}

enum CollaborationNegotiationState {
  NOT_REQUIRED
  AWAITING_BRAND_DECISION
  AWAITING_CREATOR_DECISION
  LOCKED
  FAILED
}

enum CollaborationPaymentRail {
  PLATFORM_ESCROW
  MANUAL
}

enum CollaborationSecurementState {
  NOT_REQUIRED
  AWAITING_ESCROW_FUNDING
  PROCESSING_FUNDING
  AWAITING_PAYOUT_DETAILS
  AWAITING_BRAND_PAYMENT
  AWAITING_CREATOR_CONFIRMATION
  PAYMENT_DISPUTED
  COMPLETED
  BLOCKED
}

enum CollaborationFulfillmentState {
  NOT_STARTED
  AWAITING_BRAND_FULFILLMENT
  AWAITING_CREATOR_CONFIRMATION
  REMEDIATION_REQUIRED
  COMPLETED
  SKIPPED
  HARD_STOP
  BLOCKED
}

enum CollaborationDeliverableState {
  AWAITING_SUBMISSION
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  AUTO_APPROVED
  HARD_STOP
}

enum CollaborationSubmissionReviewState {
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  AUTO_APPROVED
  FINAL_REJECTED
}

enum CollaborationPublishingState {
  PUBLISHING_NOT_REQUIRED
  AWAITING_PUBLISHING
  EVIDENCE_SUBMITTED
  CORRECTION_REQUIRED
  COMPLIANCE_VERIFIED
  BLOCKED
}

enum CollaborationPublicationAuthorizationState {
  NOT_REQUIRED
  NOT_AUTHORIZED
  AUTHORIZED
}

enum CollaborationSettlementState {
  NOT_ELIGIBLE
  ELIGIBLE
  PROCESSING
  SETTLED
  BLOCKED
}

enum CollaborationResolutionStatus {
  NOT_REQUIRED
  PENDING
  RESOLVED
}

enum CollaborationFinancialOutcome {
  NORMAL_SUCCESS
  NEGOTIATION_EXIT
  PRE_SECUREMENT_EXIT
  BRAND_PROTECTED_POST_SECUREMENT_EXIT
  FULFILLMENT_HARD_STOP
  PRODUCTION_HARD_STOP
  CREATOR_NON_PERFORMANCE
  CREATOR_PUBLISHING_NON_PERFORMANCE
  ADMIN_RESOLUTION
  OTHER_POLICY_RESOLUTION
}

enum CollaborationFeedbackAuthorRole {
  BRAND
  CREATOR
}

enum CollaborationFeedbackVisibility {
  HIDDEN
  REVEALED
}

enum CollaborationEventKind {
  DOMAIN
  AUDIT
  INTEGRATION
}

// ============================================================================
// AGGREGATE ROOT
// ============================================================================

model Collaboration {
  id String @id @default(cuid())

  // --------------------------------------------------------------------------
  // SOURCE LINEAGE
  // One approved Application is the creation identity. Do not restore
  // Campaign × Creator uniqueness.
  // --------------------------------------------------------------------------
  sourceApplicationId String @unique @map("source_application_id")
  campaignId String @map("campaign_id")
  campaignCreatorId String @map("campaign_creator_id")
  campaignAssetId String @map("campaign_asset_id")
  briefId String @map("brief_id")
  brandProfileId String @map("brand_profile_id")
  creatorUserId String @map("creator_user_id")

  // Integrated schema relation target. Campaign/Applicants remains owner of
  // Application status/history; Collaboration never mutates that history.
  sourceApplication UceApplication @relation(fields: [sourceApplicationId], references: [id], onDelete: Restrict)

  // --------------------------------------------------------------------------
  // AUTHORITATIVE EXECUTION STATE
  // --------------------------------------------------------------------------
  lifecycle CollaborationLifecycle @default(ACTIVE)
  currentStage CollaborationStage @default(NEGOTIATION) @map("current_stage")
  currentStageStatus CollaborationStageStatus @default(IN_PROGRESS) @map("current_stage_status")

  // Projection/read helper. Runtime remains authoritative for transitions.
  actionRequiredBy CollaborationActionRequiredBy @default(NONE) @map("action_required_by")

  // Optimistic concurrency / stale-command protection.
  aggregateVersion Int @default(1) @map("aggregate_version")

  // Terminal context. Terminal lifecycle does not erase the stage where the
  // Collaboration ended and does not imply financial execution is complete.
  endedFromStage CollaborationStage? @map("ended_from_stage")
  endedReasonCode String? @map("ended_reason_code")
  endedReasonText String? @map("ended_reason_text")
  endedByActorClass CollaborationActorClass? @map("ended_by_actor_class")
  endedByUserId String? @map("ended_by_user_id")
  endedAt DateTime? @map("ended_at")

  completedAt DateTime? @map("completed_at")

  // --------------------------------------------------------------------------
  // OWNED EXECUTION RECORDS
  // --------------------------------------------------------------------------
  snapshot CollaborationExecutionSnapshot?
  commercial CollaborationCommercialAgreement?
  fulfillment CollaborationFulfillment?
  deliverables CollaborationDeliverableExecution[]
  settlement CollaborationSettlement?
  financialResolution CollaborationFinancialResolution?
  feedbackWindow CollaborationFeedbackWindow?
  feedback CollaborationFeedback[]
  events CollaborationEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId, lifecycle])
  @@index([campaignCreatorId])
  @@index([campaignAssetId])
  @@index([briefId])
  @@index([brandProfileId, lifecycle])
  @@index([creatorUserId, lifecycle])
  @@index([currentStage, currentStageStatus])
  @@map("collaborations")
}

// ============================================================================
// LOCKED EXECUTION SNAPSHOT
// ============================================================================

model CollaborationExecutionSnapshot {
  id String @id @default(cuid())
  collaborationId String @unique @map("collaboration_id")

  // Reference snapshots preserve what was agreed for this execution; they do
  // not replace the live upstream lineage fields on Collaboration.
  campaignContext Json @map("campaign_context")
  campaignAssetContext Json @map("campaign_asset_context")
  briefContext Json @map("brief_context")
  applicationContext Json? @map("application_context")
  creatorContext Json? @map("creator_context")
  brandContext Json? @map("brand_context")

  // Brief-level execution terms applying across Deliverables.
  usageRights Json? @map("usage_rights")
  creatorRequirements String? @map("creator_requirements")

  // Exact frozen Create Campaign Brand Support vocabulary is used. Do not
  // create a competing industry-derived physical/digital/service taxonomy.
  receivesBrandSupport Boolean @default(false) @map("receives_brand_support")
  brandSupportType UceBrandSupportType? @map("brand_support_type")
  brandSupportEstimatedValue Decimal? @map("brand_support_estimated_value") @db.Decimal(12, 2)

  // Commercial framework snapshots. Final Creator-specific agreed fee lives in
  // CollaborationCommercialAgreement after Negotiation locks.
  campaignCommercialContext Json? @map("campaign_commercial_context")
  advancePercentageSnapshot Int @map("advance_percentage_snapshot")
  commercialCurrency String @db.VarChar(3) @map("commercial_currency")

  // Snapshot is immutable through normal runtime. Future amendment capability
  // requires an explicit contract and must not silently overwrite this row.
  lockedAt DateTime @default(now()) @map("locked_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@map("collaboration_execution_snapshots")
}

// ============================================================================
// COMMERCIAL AGREEMENT + SECUREMENT
// ============================================================================

model CollaborationCommercialAgreement {
  id String @id @default(cuid())
  collaborationId String @unique @map("collaboration_id")

  negotiationState CollaborationNegotiationState @default(AWAITING_BRAND_DECISION) @map("negotiation_state")

  // Proposal history is intentionally compact in MVP because negotiation allows
  // one Brand counter cycle rather than an open-ended bidding history.
  applicationProposedFee Decimal? @map("application_proposed_fee") @db.Decimal(14, 2)
  brandCounterFee Decimal? @map("brand_counter_fee") @db.Decimal(14, 2)
  agreedCreatorFee Decimal? @map("agreed_creator_fee") @db.Decimal(14, 2)
  currency String @db.VarChar(3)

  // Configuration-neutral Advance semantics. No 30/70 field names.
  advancePercentageSnapshot Int @map("advance_percentage_snapshot")
  advanceAmount Decimal? @map("advance_amount") @db.Decimal(14, 2)
  balanceAmount Decimal? @map("balance_amount") @db.Decimal(14, 2)

  // Product/service consideration remains non-cash and separate.
  nonCashConsideration Json? @map("non_cash_consideration")

  paymentRail CollaborationPaymentRail @default(PLATFORM_ESCROW) @map("payment_rail")
  securementState CollaborationSecurementState @default(AWAITING_ESCROW_FUNDING) @map("securement_state")

  // 100% of agreed Creator cash fee is the funding requirement for escrow.
  requiredSecuredAmount Decimal? @map("required_secured_amount") @db.Decimal(14, 2)
  confirmedSecuredAmount Decimal? @map("confirmed_secured_amount") @db.Decimal(14, 2)

  // Payout/escrow remains externally owned. These are correlation/evidence refs,
  // not escrow vault or banking ownership.
  fundingInstructionRef String? @map("funding_instruction_ref")
  fundingConfirmationRef String? @map("funding_confirmation_ref")
  manualPaymentEvidenceRef String? @map("manual_payment_evidence_ref")
  manualCreatorConfirmedAt DateTime? @map("manual_creator_confirmed_at")
  paymentDisputeRef String? @map("payment_dispute_ref")

  termsLockedAt DateTime? @map("terms_locked_at")
  securementCompletedAt DateTime? @map("securement_completed_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([negotiationState])
  @@index([securementState])
  @@map("collaboration_commercial_agreements")
}

// ============================================================================
// FULFILLMENT EXECUTION
// ============================================================================

model CollaborationFulfillment {
  id String @id @default(cuid())
  collaborationId String @unique @map("collaboration_id")

  state CollaborationFulfillmentState @default(NOT_STARTED)
  issueCount Int @default(0) @map("issue_count")

  // Operational execution evidence. The Brand Support type itself is locked in
  // CollaborationExecutionSnapshot using UceBrandSupportType.
  shipmentTrackingRef String? @map("shipment_tracking_ref")
  courierName String? @map("courier_name")
  accessEvidenceRef String? @map("access_evidence_ref")
  redemptionCode String? @map("redemption_code")
  serviceEvidenceRef String? @map("service_evidence_ref")
  genericFulfillmentEvidence Json? @map("generic_fulfillment_evidence")

  brandFulfilledAt DateTime? @map("brand_fulfilled_at")
  creatorConfirmedAt DateTime? @map("creator_confirmed_at")
  completedAt DateTime? @map("completed_at")
  hardStoppedAt DateTime? @map("hard_stopped_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  issues CollaborationFulfillmentIssue[]

  @@index([state])
  @@map("collaboration_fulfillments")
}

model CollaborationFulfillmentIssue {
  id String @id @default(cuid())
  fulfillmentId String @map("fulfillment_id")
  sequence Int

  // Exact issue taxonomy is not frozen in the canonical contracts. Keep a code
  // boundary without pretending the production enum is canonical product truth.
  issueCode String @map("issue_code")
  description String
  evidenceRef String? @map("evidence_ref")

  reportedByUserId String? @map("reported_by_user_id")
  reportedAt DateTime @default(now()) @map("reported_at")

  remediationEvidenceRef String? @map("remediation_evidence_ref")
  remediationAt DateTime? @map("remediation_at")

  fulfillment CollaborationFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentId, sequence])
  @@index([fulfillmentId, reportedAt])
  @@map("collaboration_fulfillment_issues")
}

// ============================================================================
// DELIVERABLE EXECUTION + APPEND-ORIENTED SUBMISSION VERSIONS
// ============================================================================

model CollaborationDeliverableExecution {
  id String @id @default(cuid())
  collaborationId String @map("collaboration_id")

  // Stable lineage to the frozen Brief Deliverable definition.
  sourceBriefDeliverableId String @map("source_brief_deliverable_id")
  sourceBriefDeliverable UceBriefDeliverable @relation(fields: [sourceBriefDeliverableId], references: [id], onDelete: Restrict)

  displayOrder Int @map("display_order")
  definitionSnapshot Json @map("definition_snapshot")

  state CollaborationDeliverableState @default(AWAITING_SUBMISSION)
  revisionRequestCount Int @default(0) @map("revision_request_count")

  // --------------------------------------------------------------------------
  // PUBLISHING APPLICABILITY — STRUCTURE FROZEN, UPSTREAM DERIVATION OPEN
  // --------------------------------------------------------------------------
  // This is the resolved locked execution fact used at runtime.
  // How Campaign/Brief authors or derives this value is still an explicit
  // product-data gap. Never infer it from Brand industry or from format alone.
  publishingRequired Boolean @default(false) @map("publishing_required")

  submissions CollaborationSubmissionVersion[]
  publishing CollaborationPublishingExecution?

  approvedAt DateTime? @map("approved_at")
  autoApprovedAt DateTime? @map("auto_approved_at")
  hardStoppedAt DateTime? @map("hard_stopped_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, sourceBriefDeliverableId])
  @@index([collaborationId, state])
  @@index([sourceBriefDeliverableId])
  @@map("collaboration_deliverable_executions")
}

model CollaborationSubmissionVersion {
  id String @id @default(cuid())
  deliverableExecutionId String @map("deliverable_execution_id")
  versionNumber Int @map("version_number")

  // Asset provider/storage is outside Collaboration. Existing production URLs
  // may initially be adapted into this logical reference abstraction.
  assetRef String @map("asset_ref")
  submissionMetadata Json? @map("submission_metadata")

  reviewState CollaborationSubmissionReviewState @default(UNDER_REVIEW) @map("review_state")
  brandFeedback String? @map("brand_feedback")

  // 72h review deadline is persisted per submitted version. Scheduler invokes
  // a stale-safe SYSTEM command; no scheduler technology is encoded here.
  reviewDeadlineAt DateTime @map("review_deadline_at")
  reviewedAt DateTime? @map("reviewed_at")
  reviewedByUserId String? @map("reviewed_by_user_id")
  autoApprovedAt DateTime? @map("auto_approved_at")

  createdAt DateTime @default(now()) @map("created_at")

  deliverableExecution CollaborationDeliverableExecution @relation(fields: [deliverableExecutionId], references: [id], onDelete: Cascade)

  @@unique([deliverableExecutionId, versionNumber])
  @@index([reviewState, reviewDeadlineAt])
  @@index([deliverableExecutionId, createdAt])
  @@map("collaboration_submission_versions")
}

// ============================================================================
// DELIVERABLE-AWARE PUBLISHING / COMPLIANCE
// ============================================================================

model CollaborationPublishingExecution {
  id String @id @default(cuid())
  deliverableExecutionId String @unique @map("deliverable_execution_id")

  state CollaborationPublishingState @default(PUBLISHING_NOT_REQUIRED)
  authorizationState CollaborationPublicationAuthorizationState @default(NOT_REQUIRED) @map("authorization_state")

  // Explicit publication consent is distinct from AUTO_APPROVED production.
  authorizedAt DateTime? @map("authorized_at")
  authorizedByUserId String? @map("authorized_by_user_id")

  // No universal livePostUrl field exists on Collaboration. Evidence is tied
  // to the specific Deliverable Execution and can be platform/format specific.
  publicationEvidenceRef String? @map("publication_evidence_ref")
  publicationMetadata Json? @map("publication_metadata")
  evidenceSubmittedAt DateTime? @map("evidence_submitted_at")

  complianceEvidenceRef String? @map("compliance_evidence_ref")
  correctionReason String? @map("correction_reason")
  complianceVerifiedAt DateTime? @map("compliance_verified_at")
  blockedReason String? @map("blocked_reason")

  deliverableExecution CollaborationDeliverableExecution @relation(fields: [deliverableExecutionId], references: [id], onDelete: Cascade)

  @@index([state])
  @@map("collaboration_publishing_executions")
}

// ============================================================================
// FINANCIAL ENTITLEMENT / RESOLUTION VS PAYOUT EXECUTION
// ============================================================================

model CollaborationFinancialResolution {
  id String @id @default(cuid())
  collaborationId String @unique @map("collaboration_id")

  status CollaborationResolutionStatus @default(NOT_REQUIRED)
  outcome CollaborationFinancialOutcome?

  // Entitlement is Collaboration-owned. These values say who SHOULD receive
  // what; they do not claim that Payout has moved money.
  creatorEntitlementAmount Decimal? @map("creator_entitlement_amount") @db.Decimal(14, 2)
  brandRefundEntitlementAmount Decimal? @map("brand_refund_entitlement_amount") @db.Decimal(14, 2)
  currency String? @db.VarChar(3)

  reasonCode String? @map("reason_code")
  reasonText String? @map("reason_text")
  resolutionEvidence Json? @map("resolution_evidence")
  decidedByActorClass CollaborationActorClass? @map("decided_by_actor_class")
  decidedByUserId String? @map("decided_by_user_id")

  decidedAt DateTime? @map("decided_at")
  resolvedAt DateTime? @map("resolved_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([outcome])
  @@map("collaboration_financial_resolutions")
}

model CollaborationSettlement {
  id String @id @default(cuid())
  collaborationId String @unique @map("collaboration_id")

  state CollaborationSettlementState @default(NOT_ELIGIBLE)

  // The settlement instruction mirrors the current authoritative entitlement
  // when payout execution is requested. Payout remains owner of execution.
  creatorSettlementAmount Decimal? @map("creator_settlement_amount") @db.Decimal(14, 2)
  brandRefundAmount Decimal? @map("brand_refund_amount") @db.Decimal(14, 2)
  currency String? @db.VarChar(3)

  payoutInstructionRef String? @map("payout_instruction_ref")
  payoutExecutionRef String? @map("payout_execution_ref")
  refundExecutionRef String? @map("refund_execution_ref")
  authoritativeConfirmationRef String? @map("authoritative_confirmation_ref")

  eligibleAt DateTime? @map("eligible_at")
  processingAt DateTime? @map("processing_at")
  settledAt DateTime? @map("settled_at")
  blockedAt DateTime? @map("blocked_at")
  blockedReason String? @map("blocked_reason")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([state])
  @@map("collaboration_settlements")
}

// ============================================================================
// POST-COMPLETION FEEDBACK
// ============================================================================

model CollaborationFeedbackWindow {
  id String @id @default(cuid())
  collaborationId String @unique @map("collaboration_id")

  openedAt DateTime @map("opened_at")
  closesAt DateTime @map("closes_at")
  visibility CollaborationFeedbackVisibility @default(HIDDEN)
  revealedAt DateTime? @map("revealed_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([visibility, closesAt])
  @@map("collaboration_feedback_windows")
}

model CollaborationFeedback {
  id String @id @default(cuid())
  collaborationId String @map("collaboration_id")
  authorRole CollaborationFeedbackAuthorRole @map("author_role")
  authorUserId String? @map("author_user_id")

  // Rating range validation belongs to command validation/runtime.
  rating Int
  reviewText String? @map("review_text")
  submittedAt DateTime @default(now()) @map("submitted_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, authorRole])
  @@index([collaborationId, submittedAt])
  @@map("collaboration_feedback")
}

// ============================================================================
// APPEND-ORIENTED DOMAIN / AUDIT HISTORY
// ============================================================================

model CollaborationEvent {
  id String @id @default(cuid())
  collaborationId String @map("collaboration_id")

  kind CollaborationEventKind @default(DOMAIN)
  eventType String @map("event_type")
  actorClass CollaborationActorClass @map("actor_class")
  actorUserId String? @map("actor_user_id")

  // Idempotency/correlation. Exact command DTO remains a runtime concern.
  commandId String? @map("command_id")
  correlationId String? @map("correlation_id")
  aggregateVersion Int @map("aggregate_version")
  payload Json?

  occurredAt DateTime @default(now()) @map("occurred_at")

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, aggregateVersion])
  @@index([collaborationId, occurredAt])
  @@index([commandId])
  @@index([eventType, occurredAt])
  @@map("collaboration_events")
}

// ============================================================================
// INTEGRATED-SCHEMA REVERSE RELATIONS REQUIRED OUTSIDE THIS WORKING VIEW
// ============================================================================
//
// UceApplication should gain an optional reverse relation to Collaboration,
// preserving Applicants/Campaign ownership of Application lifecycle/history.
//
// UceBriefDeliverable should gain a reverse collection for
// CollaborationDeliverableExecution lineage.
//
// Example only (add to their owning models during integration):
//
// model UceApplication {
//   ...
//   collaboration Collaboration?
// }
//
// model UceBriefDeliverable {
//   ...
//   collaborationExecutions CollaborationDeliverableExecution[]
// }
//
// ============================================================================
// PERSISTENCE BOUNDARY / NON-GOALS
// ============================================================================
// - No Campaign × Creator uniqueness. Source Application is the idempotency key.
// - No second UceCampaignCollaboration operational aggregate.
// - No `isPaused` / `isTerminated` workflow-authority booleans.
// - No hard-coded 30/70 commercial fields or ADVANCE_30 / FINAL_70 policy.
// - No BARTER payment rail.
// - No Creator bank-account ownership in Collaboration.
// - No industry-derived fulfillment routing.
// - No global Collaboration revision counter.
// - No single Collaboration-level live-post URL/compliance boolean.
// - No storage-provider identity in submission records.
// - No Stage 6 Feedback execution stage.
// - No assumption that persisted deadlines execute themselves.
// - No direct Payout money-movement ownership.
// - No PAUSE behavior beyond preserving the lifecycle capability.
//
// Existing production escrow locks, ledger and idempotency infrastructure are
// migration/reuse targets and remain Payout/infrastructure-owned; they should be
// generalized away from fixed 30/70 policy rather than duplicated here.
// ============================================================================
